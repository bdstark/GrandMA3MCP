{
  "name": "gma3-mcp",
  "version": "0.1.0",
  "description": "MCP server for grandMA3 onPC: command line, Lua, and show data access via an in-console Lua bridge plugin",
  "type": "module",
  "bin": {
    "gma3-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:lua": "lua test/lua/bridge_plugin_test.lua && lua test/lua/modules_test.lua && lua test/lua/hardkeys_sessions_test.lua && lua test/lua/hardkeys_routing_test.lua && lua test/lua/hardkeys_bank_test.lua && lua test/lua/hardkeys_quickey_test.lua",
    "coverage": "node --import tsx --enable-source-maps --test --experimental-test-coverage --test-coverage-include='src/**' test/*.test.ts",
    "coverage:lcov": "mkdir -p coverage && node --import tsx --enable-source-maps --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts",
    "install-plugin": "sh scripts/install-plugin.sh",
    "test:live": "node --import tsx --test --test-concurrency=1 'test/live/*.live.ts'",
    "ci": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Brian Stark <bdstark@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdstark/GrandMA3MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  }
}
